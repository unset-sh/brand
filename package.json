{
  "name": "@unset-sh/brand",
  "version": "0.1.1",
  "description": "Unset brand contract, CSS tokens, style adapters, fonts, icons and usage guidelines.",
  "license": "(AGPL-3.0-only AND OFL-1.1 AND LicenseRef-unset-sh-brand-assets)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unset-sh/brand.git"
  },
  "type": "module",
  "files": [
    "dist/",
    "fonts/",
    "logo/",
    "icons/",
    "guidelines/",
    "provenance/",
    "source.json",
    "LICENSE-ASSETS.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./contract.json": "./dist/contract.json",
    "./contract.schema.json": "./dist/contract.schema.json",
    "./resolved.json": "./dist/resolved.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./recipes.css": "./dist/recipes.css",
    "./meta.json": "./dist/meta.json",
    "./tokens.json": "./dist/contract.json",
    "./source.json": "./source.json",
    "./syntax/*": "./dist/syntax/*",
    "./fonts/*": "./fonts/*",
    "./logo/*": "./logo/*",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node site/gallery/scripts/build-syntax.mjs --check && node --test checks/*.test.mjs site/gallery/checks/*.test.mjs",
    "query": "node scripts/query.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "python3 -m http.server 49740 --bind 127.0.0.1 --directory site/public",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts && npm run build"
  },
  "devDependencies": {
    "svelte": "5.57.3",
    "bits-ui": "2.20.6",
    "cn": "0.5.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "@tailwindcss/vite": "4.3.5",
    "vite": "8.3.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@internationalized/date": "3.12.4",
    "runed": "0.37.1",
    "svelte-toolbelt": "0.10.6",
    "embla-carousel-svelte": "8.6.0",
    "paneforge": "1.0.2",
    "vaul-svelte": "1.0.0-next.7",
    "layerchart": "2.0.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.2.0",
    "@tanstack/svelte-table": "9.0.0",
    "@tanstack/virtual-core": "3.17.10",
    "esm-env": "1.2.2",
    "shiki": "3.20.0",
    "@changesets/cli": "3.0.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "error"
    }
  }
}
