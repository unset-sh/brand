      "filename": "profile.ts",
      "code": "import type { Profile } from './types';\n\n// A small space, made your own.\nconst profile: Profile = {\n  name: 'Mika Rowan',\n  visibility: 'public',\n  featured: true,\n  postLimit: 12,\n};\n\nexport function greet(name: string) {\n  return `Welcome, ${name}.`;\n}\n\nexport default profile;"
    },
    {
      "id": "svelte",
      "label": "Svelte",
      "filename": "Profile.svelte",
      "code": "<script lang=\"ts\">\n  import { Button } from '$lib/ui/button';\n  let follows = $state(12);\n</script>\n\n<!-- A profile that feels like you. -->\n<section aria-label=\"Profile\">\n  <h2>Mika Rowan</h2>\n  <p>{follows} people following</p>\n  <Button onclick={() => follows += 1}>\n    Follow profile\n  </Button>\n</section>"
    },
    {
      "id": "css",
      "label": "CSS",
      "filename": "profile.css",
      "code": "/* Shared foundations, personal expression. */\n.profile {\n  display: grid;\n  gap: 1.5rem;\n  color: var(--foreground);\n  background: var(--background);\n  font-family: 'Space Grotesk', sans-serif;\n}\n\n.profile:focus-visible {\n  outline: 2px solid currentColor;\n  outline-offset: 3px;\n}"
    },
