{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unset:brand-contract:schema:1",
  "title": "Unset brand contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "scope",
    "statusDefinitions",
    "decisions",
    "tokens",
    "rules",
    "typography",
    "icons",
    "mark",
    "componentRecipes",
    "syntax",
    "accessibility",
    "openDecisions",
    "consumption",
    "precedence",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "unset.brand"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "reviewable",
        "released"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "published",
        "productionMigrated"
      ],
      "properties": {
        "published": {
          "type": "boolean"
        },
        "productionMigrated": {
          "type": "boolean"
        }
      }
    },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pinned-asset",
              "repository-record",
              "guidance"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pinned-asset"
                }
              }
            },
            "then": {
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "repository-record"
                }
              }
            },
            "then": {
              "required": [
                "path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "guidance"
                }
              }
            },
            "then": {
              "required": [
                "url",
                "accessed"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "statusDefinitions": {
      "type": "object"
    },
    "typography": {
      "type": "object"
    },
    "icons": {
      "type": "object"
    },
    "mark": {
      "type": "object"
    },
    "componentRecipes": {
      "type": "object"
    },
    "syntax": {
      "type": "object"
    },
    "accessibility": {
      "type": "object"
    },
    "consumption": {
      "type": "object"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openDecisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "required": [
        "id",
        "type",
        "kind",
        "status",
        "usage",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "type": {
          "enum": [
            "color",
            "dimension",
            "fontFamily",
            "number"
          ]
        },
        "kind": {
          "enum": [
            "primitive",
            "semantic",
            "component"
          ]
        },
        "status": {
          "enum": [
            "selected",
            "working",
            "inherited",
            "provisional",
            "unverified",
            "requirement"
          ]
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cssVariable": {
          "type": "string",
          "pattern": "^--[a-z][a-z0-9-]*$"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "values": {
          "type": "object",
          "required": [
            "light",
            "dark"
          ],
          "properties": {
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "ref": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "values"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "values"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "values"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "authoring-rule",
            "accessibility-requirement"
          ]
        },
        "status": {
          "enum": [
            "selected",
            "working",
            "inherited",
            "provisional",
            "unverified",
            "requirement"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
